import tkinter as tk
from tkinter import messagebox
import random

# Размер поля
SIZE = 10


class Ship:
    def __init__(self, size: int):
        self.size = size
        self.hits = 0
        self.positions = []
        self.horizontal = True

    def is_sunk(self) -> bool:
        return self.hits >= self.size


class IntelligentShipPlacer:
    def __init__(self, board_size: int = 10):
        self.board_size = board_size

    def place_ships_intelligently(self, ships: list) -> list:
        """Интеллектуальная расстановка кораблей"""
        field = [[0 for _ in range(self.board_size)] for _ in range(self.board_size)]

        for ship_size in sorted(ships, reverse=True):
            placed = False
            attempts = 0

            while not placed and attempts < 100:
                row = random.randint(0, self.board_size - 1)
                col = random.randint(0, self.board_size - 1)
                horizontal = random.choice([True, False])

                if self.can_place_ship(field, row, col, ship_size, horizontal):
                    self.put_ship(field, row, col, ship_size, horizontal)
                    placed = True

                attempts += 1

            if not placed:
                # Если не удалось разместить, пробуем другой подход
                for r in range(self.board_size):
                    for c in range(self.board_size):
                        for hor in [True, False]:
                            if self.can_place_ship(field, r, c, ship_size, hor):
                                self.put_ship(field, r, c, ship_size, hor)
                                placed = True
                                break
                        if placed:
                            break
                    if placed:
                        break

        return field

    def can_place_ship(self, field, row, col, size, horizontal):
        if horizontal:
            if col + size > self.board_size:
                return False
            for i in range(size):
                if field[row][col + i] != 0 or self.has_adjacent_ships(field, row, col + i):
                    return False
        else:
            if row + size > self.board_size:
                return False
            for i in range(size):
                if field[row + i][col] != 0 or self.has_adjacent_ships(field, row + i, col):
                    return False
        return True

    def has_adjacent_ships(self, field, row, col):
        for dr in [-1, 0, 1]:
            for dc in [-1, 0, 1]:
                r, c = row + dr, col + dc
                if 0 <= r < self.board_size and 0 <= c < self.board_size:
                    if field[r][c] != 0:
                        return True
        return False

    def put_ship(self, field, row, col, size, horizontal):
        if horizontal:
            for i in range(size):
                field[row][col + i] = 1
        else:
            for i in range(size):
                field[row + i][col] = 1


class SeaBattle:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title("Морской бой")
        self.root.geometry("800x700")

        # Поля игрока и компьютера
        self.player_field = [[0 for _ in range(SIZE)] for _ in range(SIZE)]
        self.computer_field = [[0 for _ in range(SIZE)] for _ in range(SIZE)]

        # Счетчики попаданий
        self.player_hits = 0
        self.computer_hits = 0

        # Флаг окончания игры
        self.game_over = False

        # Режим расстановки кораблей
        self.setup_mode = True
        self.ships_to_place = [4, 3, 3, 2, 2, 2, 1, 1, 1, 1]  # Корабли для размещения
        self.current_ship_index = 0
        self.current_direction = 'h'  # 'h' - горизонтально, 'v' - вертикально

        # Расставляем корабли компьютера с помощью интеллектуального метода
        self.place_ships_computer()

        # Создаем интерфейс
        self.create_ui()

    def place_ships_computer(self):
        """Размещение кораблей компьютера с помощью интеллектуального метода"""
        ship_placer = IntelligentShipPlacer(SIZE)
        self.computer_field = ship_placer.place_ships_intelligently(self.ships_to_place)

    def place_ship_on_field(self, row, col):
        """Размещение корабля на поле игрока"""
        if not self.setup_mode:
            return

        if self.current_ship_index >= len(self.ships_to_place):
            return

        ship_size = self.ships_to_place[self.current_ship_index]

        if self.can_place_ship(self.player_field, row, col, ship_size, self.current_direction):
            self.put_ship(self.player_field, row, col, ship_size, self.current_direction)
            self.current_ship_index += 1

            # Обновляем визуализацию
            self.update_player_field_display()

            # Проверяем, все ли корабли размещены
            if self.current_ship_index >= len(self.ships_to_place):
                self.setup_mode = False
                self.info_label.config(text="Все корабли размещены! Нажмите 'Начать игру'")
                if hasattr(self, 'start_button'):
                    self.start_button.config(state="normal")
            else:
                next_ship = self.ships_to_place[self.current_ship_index]
                self.info_label.config(text=f"Разместите корабль размером {next_ship}")
        else:
            self.info_label.config(text="Нельзя разместить корабль здесь!")

    def can_place_ship(self, field, row, col, size, direction):
        if direction == 'h':
            if col + size > SIZE:
                return False
            for c in range(col, col + size):
                if field[row][c] != 0 or self.has_adjacent_ships(field, row, c):
                    return False
        else:  # вертикально
            if row + size > SIZE:
                return False
            for r in range(row, row + size):
                if field[r][col] != 0 or self.has_adjacent_ships(field, r, col):
                    return False
        return True

    def has_adjacent_ships(self, field, row, col):
        """Проверяет, есть ли соседние корабли вокруг клетки"""
        for dr in [-1, 0, 1]:
            for dc in [-1, 0, 1]:
                r, c = row + dr, col + dc
                if 0 <= r < SIZE and 0 <= c < SIZE:
                    if field[r][c] != 0:
                        return True
        return False

    def put_ship(self, field, row, col, size, direction):
        if direction == 'h':
            for c in range(col, col + size):
                field[row][c] = 1
        else:
            for r in range(row, row + size):
                field[r][col] = 1

    def update_player_field_display(self):
        """Обновление отображения поля игрока"""
        for i in range(SIZE):
            for j in range(SIZE):
                btn = self.player_buttons[i][j]
                if self.player_field[i][j] == 1:
                    btn.config(bg="gray")
                else:
                    btn.config(bg="lightblue")

